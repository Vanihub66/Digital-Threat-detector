# ThreatDetector AI frontend configuration.
# Copy to .env.local and adjust. Only NEXT_PUBLIC_* values reach the browser —
# never put secrets or third-party API keys here.

# "demo"  → run the clearly-labelled local demo engines (default, no backend needed)
# "api"   → call the FastAPI backend at NEXT_PUBLIC_API_BASE_URL, falling back to demo if unreachable
NEXT_PUBLIC_THREATDETECTOR_MODE=demo

# Base URL of the (proposed) FastAPI backend, e.g. http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Request timeout in milliseconds for API calls (video uploads use 4x this value)
NEXT_PUBLIC_API_TIMEOUT_MS=20000
